# Copy to .env and fill in. Never commit .env.

# Required. One key for TinyAgent, TinySearch and TinyFetch.
# Get it at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# How many TinyFish agents run at once. Match your plan's concurrency limit
# (2 on the free/student plan); extra agents wait their turn in LaunchPad.
TINYFISH_MAX_PARALLEL=2

# Optional. Only used to reword two summary sentences more naturally.
# All scores work without these. If both are set, Gemini is used.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
